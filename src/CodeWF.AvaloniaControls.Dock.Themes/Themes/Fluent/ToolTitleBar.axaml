<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Dock.Model.Core"
        xmlns:controls="using:Dock.Model.Controls"
        xmlns:converters="using:Dock.Avalonia.Converters"
        xmlns:semi="https://irihi.tech/semi"
        x:DataType="controls:IToolDock"
        x:CompileBindings="True">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CodeWFToolTitleBarBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveBackgroundBrush" Color="#FAFDFF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarDividerBrush" Color="#DCEBF8" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarForegroundBrush" Color="#111827" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveForegroundBrush" Color="#071B2C" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveIndicatorBrush" Color="#147FE8" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonForegroundBrush" Color="#111827" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPointerOverBackgroundBrush" Color="#EEF5FF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPressedBackgroundBrush" Color="#DCEBFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CodeWFToolTitleBarBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveBackgroundBrush" Color="#FAFDFF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarDividerBrush" Color="#DCEBF8" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarForegroundBrush" Color="#111827" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveForegroundBrush" Color="#071B2C" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveIndicatorBrush" Color="#147FE8" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonForegroundBrush" Color="#111827" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPointerOverBackgroundBrush" Color="#EEF5FF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPressedBackgroundBrush" Color="#DCEBFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CodeWFToolTitleBarBackgroundBrush" Color="#111827" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveBackgroundBrush" Color="#162033" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarDividerBrush" Color="#2C3B4E" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarForegroundBrush" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveIndicatorBrush" Color="#76A9FF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonForegroundBrush" Color="#F9FAFB" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPointerOverBackgroundBrush" Color="#1F2937" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPressedBackgroundBrush" Color="#374151" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static semi:SemiTheme.Aquatic}">
                    <SolidColorBrush x:Key="CodeWFToolTitleBarBackgroundBrush" Color="#F4FDFF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveBackgroundBrush" Color="#F6FDFF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarDividerBrush" Color="#CDE9EF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarForegroundBrush" Color="#0F3E4A" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveForegroundBrush" Color="#062D36" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveIndicatorBrush" Color="#0EA5B7" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonForegroundBrush" Color="#0F3E4A" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPointerOverBackgroundBrush" Color="#DDF7FC" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPressedBackgroundBrush" Color="#C3EEF7" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static semi:SemiTheme.Desert}">
                    <SolidColorBrush x:Key="CodeWFToolTitleBarBackgroundBrush" Color="#FFF9F0" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveBackgroundBrush" Color="#FFF9F0" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarDividerBrush" Color="#E8D9C2" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarForegroundBrush" Color="#4A3214" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveForegroundBrush" Color="#2F1D08" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveIndicatorBrush" Color="#C77B2A" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonForegroundBrush" Color="#4A3214" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPointerOverBackgroundBrush" Color="#F7E8D2" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPressedBackgroundBrush" Color="#EFD7B5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static semi:SemiTheme.Dusk}">
                    <SolidColorBrush x:Key="CodeWFToolTitleBarBackgroundBrush" Color="#FFF7F4" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveBackgroundBrush" Color="#FFF8FB" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarDividerBrush" Color="#DDD7EA" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarForegroundBrush" Color="#4B2634" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveForegroundBrush" Color="#2B1535" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveIndicatorBrush" Color="#8A63D2" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonForegroundBrush" Color="#4B2634" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPointerOverBackgroundBrush" Color="#F7E2E7" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPressedBackgroundBrush" Color="#EDCDD8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static semi:SemiTheme.NightSky}">
                    <SolidColorBrush x:Key="CodeWFToolTitleBarBackgroundBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveBackgroundBrush" Color="#17213A" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarDividerBrush" Color="#2D3A52" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarForegroundBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarActiveIndicatorBrush" Color="#7AA2FF" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonForegroundBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPointerOverBackgroundBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="CodeWFToolTitleBarButtonPressedBackgroundBrush" Color="#334155" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="CodeWFToolTitleBarHeight">34</x:Double>
            <Thickness x:Key="CodeWFToolTitleBarPadding">12 0 6 0</Thickness>
            <Thickness x:Key="CodeWFToolTitleBarContentMargin">8 0 4 0</Thickness>
            <Thickness x:Key="CodeWFToolTitleBarButtonMargin">0</Thickness>
            <Thickness x:Key="CodeWFToolTitleBarButtonPadding">0</Thickness>
            <x:Double x:Key="CodeWFToolTitleBarButtonSize">24</x:Double>
            <x:Double x:Key="CodeWFToolTitleBarIconSize">10</x:Double>

            <DataTemplate x:Key="CodeWFToolTitleBarContentTemplate" DataType="core:IDockable">
                <Panel />
            </DataTemplate>

            <DataTemplate x:Key="CodeWFToolTitleTabHeaderTemplate" DataType="core:IDockable">
                <TextBlock Text="{Binding Title}"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
            </DataTemplate>

            <ControlTheme x:Key="CodeWFToolTitleBarButtonTheme"
                          TargetType="Button"
                          BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="{DynamicResource CodeWFToolTitleBarButtonMargin}" />
        <Setter Property="Padding" Value="{DynamicResource CodeWFToolTitleBarButtonPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="{DynamicResource CodeWFToolTitleBarButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource CodeWFToolTitleBarButtonSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarButtonPointerOverBackgroundBrush}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarButtonPressedBackgroundBrush}" />
        </Style>
            </ControlTheme>

            <ControlTheme x:Key="CodeWFToolChromeControlTheme"
                          TargetType="ToolChromeControl"
                          BasedOn="{StaticResource {x:Type ToolChromeControl}}">
        <Setter Property="ToolFlyout" Value="{x:Null}" />
        <Setter Property="CloseButtonTheme" Value="{StaticResource CodeWFToolTitleBarButtonTheme}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <DockableControl DataContext="{Binding ActiveDockable}"
                                     TrackingMode="Visible"
                                     Grid.Row="1">
                        <DeferredContentControl x:Name="PART_ActiveContentPresenter"
                                                Content="{Binding}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch">
                            <DeferredContentControl.ContentTemplate>
                                <ControlRecyclingDataTemplate Parent="{Binding #PART_ActiveContentPresenter}" />
                            </DeferredContentControl.ContentTemplate>
                        </DeferredContentControl>
                    </DockableControl>
                    <Border x:Name="PART_Border"
                            Background="{DynamicResource CodeWFToolTitleBarBackgroundBrush}"
                            BorderBrush="{DynamicResource CodeWFToolTitleBarDividerBrush}"
                            Padding="{DynamicResource CodeWFToolTitleBarPadding}"
                            VerticalAlignment="Top"
                            Grid.Row="{Binding GripMode, Converter={x:Static GripModeConverters.GridRowAutoHideConverter}}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.16" />
                            </Transitions>
                        </Border.Transitions>
                        <Grid x:Name="PART_Grip"
                              ColumnDefinitions="Auto,Auto,*,Auto"
                              Height="{DynamicResource CodeWFToolTitleBarHeight}">
                            <Grid.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                                </Transitions>
                            </Grid.Transitions>
                            <Border x:Name="PART_ActiveIndicator"
                                    Grid.Column="0"
                                    Width="3"
                                    Height="16"
                                    Margin="0 0 8 0"
                                    CornerRadius="2"
                                    Opacity="0"
                                    Background="{DynamicResource CodeWFToolTitleBarActiveIndicatorBrush}"
                                    VerticalAlignment="Center">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <TabStrip x:Name="PART_TitleTabs"
                                      Grid.Column="1"
                                      ItemsSource="{Binding VisibleDockables}"
                                      SelectedItem="{Binding ActiveDockable, Mode=TwoWay}"
                                      ItemTemplate="{DynamicResource CodeWFToolTitleTabHeaderTemplate}" />
                            <ContentControl x:Name="PART_TitleBarContent"
                                            Grid.Column="2"
                                            Content="{Binding ActiveDockable}"
                                            ContentTemplate="{DynamicResource CodeWFToolTitleBarContentTemplate}"
                                            Margin="{DynamicResource CodeWFToolTitleBarContentMargin}" />
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="3"
                                    Command="{Binding Owner.Factory.CloseDockable}"
                                    CommandParameter="{Binding ActiveDockable}"
                                    Theme="{TemplateBinding CloseButtonTheme}">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <MultiBinding Converter="{x:Static converters:DockCapabilityConverters.CanCloseMultiConverter}">
                                            <Binding Path="ActiveDockable" />
                                            <Binding Path="ActiveDockable.CanClose" />
                                            <Binding Path="ActiveDockable.DockCapabilityOverrides.CanClose" />
                                            <Binding Path="(core:IDock).DockCapabilityPolicy.CanClose" />
                                        </MultiBinding>
                                        <MultiBinding Converter="{x:Static converters:CanRemoveDockableConverter.Instance}">
                                            <Binding Path="(core:IDock).CanCloseLastDockable" FallbackValue="{x:True}" />
                                            <Binding Path="(core:IDock).VisibleDockables.Count" FallbackValue="0" />
                                        </MultiBinding>
                                    </MultiBinding>
                                </Button.IsVisible>
                                <Viewbox Width="{DynamicResource CodeWFToolTitleBarIconSize}"
                                         Height="{DynamicResource CodeWFToolTitleBarIconSize}">
                                    <Path x:Name="PART_ClosePath" />
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>
                    <Panel x:Name="PART_Panel"
                           Background="{DynamicResource CodeWFToolTitleBarDividerBrush}"
                           Height="{DynamicResource DockToolChromeDividerThickness}"
                           VerticalAlignment="Top"
                           Grid.Row="{Binding GripMode, Converter={x:Static GripModeConverters.GridRowAutoHideConverter}}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^/template/ Border#PART_Border">
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="IsVisible"
                    Value="{Binding GripMode, Converter={x:Static GripModeConverters.IsVisibleVisibleConverter}}" />
        </Style>
        <Style Selector="^:active /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarActiveBackgroundBrush}" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="IsVisible"
                    Value="{Binding GripMode, Converter={x:Static GripModeConverters.IsVisibleAutoHideOrVisibleConverter}}" />
        </Style>

        <Style Selector="^:floating /template/ Border#PART_Border">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="^/template/ Panel#PART_Panel">
            <Setter Property="IsVisible"
                    Value="{Binding GripMode, Converter={x:Static GripModeConverters.IsVisibleAutoHideOrHiddenConverter}}" />
        </Style>

        <Style Selector="^:pointerover /template/ Panel#PART_Panel">
            <Setter Property="IsVisible"
                    Value="{Binding GripMode, Converter={x:Static GripModeConverters.IsVisibleVisibleOrHiddenConverter}}" />
        </Style>

        <Style Selector="^:floating:pointerover /template/ Panel#PART_Panel">
            <Setter Property="Height" Value="0" />
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^/template/ Grid#PART_Grip">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarBackgroundBrush}" />
            <Setter Property="(DockProperties.IsDragArea)" Value="True" />
        </Style>
        <Style Selector="^:active /template/ Grid#PART_Grip">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarActiveBackgroundBrush}" />
        </Style>
        <Style Selector="^:active /template/ Border#PART_ActiveIndicator">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:floating /template/ Grid#PART_Grip">
            <Setter Property="(DockProperties.IsDragArea)"
                    Value="{Binding $parent[HostWindow].ToolChromeControlsWholeWindow, Mode=OneWay, Converter={x:Static BoolConverters.Not}}" />
        </Style>

        <Style Selector="^/template/ TextBlock#PART_Title">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:active /template/ TextBlock#PART_Title">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarActiveForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ TextBlock#PART_Title">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^/template/ TabStrip#PART_TitleTabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="^/template/ TabStrip#PART_TitleTabs TabStripItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{DynamicResource CodeWFToolTitleBarHeight}" />
            <Setter Property="Padding" Value="8 0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="^/template/ TabStrip#PART_TitleTabs TabStripItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarActiveForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0 0 0 2" />
            <Setter Property="BorderBrush" Value="{DynamicResource CodeWFToolTitleBarActiveIndicatorBrush}" />
        </Style>
        <Style Selector="^/template/ TabStrip#PART_TitleTabs TabStripItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarButtonPointerOverBackgroundBrush}" />
        </Style>

        <Style Selector="^/template/ ContentControl#PART_TitleBarContent">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="^/template/ Path#PART_ClosePath">
            <Setter Property="Data" Value="{DynamicResource DockToolIconCloseGeometry}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:active /template/ Path#PART_ClosePath">
            <Setter Property="Fill" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Path#PART_ClosePath">
            <Setter Property="Fill" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^/template/ Button#PART_CloseButton">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:active /template/ Button#PART_CloseButton">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Button#PART_CloseButton">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
