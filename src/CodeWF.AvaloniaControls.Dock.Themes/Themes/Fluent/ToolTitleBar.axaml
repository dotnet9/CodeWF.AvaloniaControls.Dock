<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Dock.Model.Core"
        xmlns:controls="using:Dock.Model.Controls"
        xmlns:converters="using:Dock.Avalonia.Converters"
        x:DataType="controls:IToolDock"
        x:CompileBindings="True">
    <Styles.Resources>
        <ResourceDictionary>
            <StaticResource x:Key="CodeWFToolPanelBackgroundBrush" ResourceKey="SemiColorBackground0" />
            <StaticResource x:Key="CodeWFToolPanelBorderBrush" ResourceKey="SemiColorBorder" />
            <StaticResource x:Key="CodeWFToolTitleBarBackgroundBrush" ResourceKey="SemiColorFill0" />
            <StaticResource x:Key="CodeWFToolTitleBarActiveBackgroundBrush" ResourceKey="SemiColorFill0" />
            <StaticResource x:Key="CodeWFToolTitleBarDividerBrush" ResourceKey="SemiColorBorder" />
            <StaticResource x:Key="CodeWFToolTitleBarForegroundBrush" ResourceKey="SemiColorText0" />
            <StaticResource x:Key="CodeWFToolTitleBarActiveForegroundBrush" ResourceKey="SemiColorText0" />
            <StaticResource x:Key="CodeWFToolTitleBarActiveIndicatorBrush" ResourceKey="SemiColorBorder" />
            <StaticResource x:Key="CodeWFToolTitleBarButtonForegroundBrush" ResourceKey="SemiColorText2" />
            <StaticResource x:Key="CodeWFToolTitleBarButtonPointerOverBackgroundBrush" ResourceKey="SemiColorFill2" />
            <StaticResource x:Key="CodeWFToolTitleBarButtonPressedBackgroundBrush" ResourceKey="SemiColorFill2" />

            <x:Double x:Key="CodeWFToolTitleBarHeight">24</x:Double>
            <Thickness x:Key="CodeWFToolTitleBarPadding">0</Thickness>
            <Thickness x:Key="CodeWFToolTitleBarContentMargin">4 0 2 0</Thickness>
            <Thickness x:Key="CodeWFToolTitleBarButtonMargin">0</Thickness>
            <Thickness x:Key="CodeWFToolTitleBarButtonPadding">0</Thickness>
            <x:Double x:Key="CodeWFToolTitleBarButtonSize">22</x:Double>
            <x:Double x:Key="CodeWFToolTitleBarIconSize">9</x:Double>

            <DataTemplate x:Key="CodeWFToolTitleBarContentTemplate" DataType="core:IDockable">
                <Panel />
            </DataTemplate>

            <DataTemplate x:Key="CodeWFToolTitleTabHeaderTemplate" DataType="core:IDockable">
                <TextBlock x:Name="PART_Title"
                           Text="{Binding Title}"
                           Foreground="{DynamicResource CodeWFToolTitleBarForegroundBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           TextAlignment="Left" />
            </DataTemplate>

            <ControlTheme x:Key="{x:Type ToolDockControl}"
                          TargetType="ToolDockControl">
                <Setter Property="(AutomationProperties.AutomationId)" Value="{Binding Id}" />
                <Setter Property="(AutomationProperties.Name)" Value="{Binding Title}" />
                <Setter Property="(DockProperties.IsDragEnabled)" Value="{Binding CanDrag}" />
                <Setter Property="(DockProperties.IsDropEnabled)" Value="{Binding CanDrop}" />
                <Setter Property="(DockProperties.DockGroup)" Value="{Binding DockGroup}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="MinWidth" Value="{Binding MinWidth}" />
                <Setter Property="MaxWidth" Value="{Binding MaxWidth}" />
                <Setter Property="MinHeight" Value="{Binding MinHeight}" />
                <Setter Property="MaxHeight" Value="{Binding MaxHeight}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <DockableControl Name="PART_DockableControl"
                                         TrackingMode="Visible"
                                         Background="{TemplateBinding Background}"
                                         DockProperties.IsDropArea="True"
                                         DockProperties.IsDockTarget="True">
                            <Border Background="{DynamicResource CodeWFToolPanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource CodeWFToolPanelBorderBrush}"
                                    BorderThickness="1"
                                    IsVisible="{Binding !!OpenedDockablesCount}">
                                <ToolChromeControl IsActive="{Binding IsActive}">
                                    <ToolControl />
                                </ToolChromeControl>
                            </Border>
                        </DockableControl>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>

            <ControlTheme x:Key="CodeWFToolTitleBarButtonTheme"
                          TargetType="Button"
                          BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="{DynamicResource CodeWFToolTitleBarButtonMargin}" />
        <Setter Property="Padding" Value="{DynamicResource CodeWFToolTitleBarButtonPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="{DynamicResource CodeWFToolTitleBarButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource CodeWFToolTitleBarButtonSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarButtonPointerOverBackgroundBrush}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarButtonPressedBackgroundBrush}" />
        </Style>
            </ControlTheme>

            <ControlTheme x:Key="CodeWFToolChromeControlTheme"
                          TargetType="ToolChromeControl"
                          BasedOn="{StaticResource {x:Type ToolChromeControl}}">
        <Setter Property="ToolFlyout" Value="{x:Null}" />
        <Setter Property="CloseButtonTheme" Value="{StaticResource CodeWFToolTitleBarButtonTheme}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <DockableControl DataContext="{Binding ActiveDockable}"
                                     TrackingMode="Visible"
                                     Grid.Row="1">
                        <DeferredContentControl x:Name="PART_ActiveContentPresenter"
                                                Content="{Binding}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch">
                            <DeferredContentControl.ContentTemplate>
                                <ControlRecyclingDataTemplate Parent="{Binding #PART_ActiveContentPresenter}" />
                            </DeferredContentControl.ContentTemplate>
                        </DeferredContentControl>
                    </DockableControl>
                    <Border x:Name="PART_Border"
                            Background="{DynamicResource CodeWFToolTitleBarBackgroundBrush}"
                            BorderBrush="{DynamicResource CodeWFToolTitleBarDividerBrush}"
                            Padding="{DynamicResource CodeWFToolTitleBarPadding}"
                            VerticalAlignment="Top"
                            Grid.Row="{Binding GripMode, Converter={x:Static GripModeConverters.GridRowAutoHideConverter}}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.16" />
                            </Transitions>
                        </Border.Transitions>
                        <Grid x:Name="PART_Grip"
                              ColumnDefinitions="Auto,*,Auto"
                              Height="{DynamicResource CodeWFToolTitleBarHeight}">
                            <Grid.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                                </Transitions>
                            </Grid.Transitions>
                            <TabStrip x:Name="PART_TitleTabs"
                                      Grid.Column="0"
                                      ItemsSource="{Binding VisibleDockables}"
                                      SelectedItem="{Binding ActiveDockable, Mode=TwoWay}"
                                      ItemTemplate="{DynamicResource CodeWFToolTitleTabHeaderTemplate}">
                                <TabStrip.Resources>
                                    <StaticResource x:Key="TabItemLinePipeSelectedBackground"
                                                    ResourceKey="CodeWFToolTitleBarActiveIndicatorBrush" />
                                </TabStrip.Resources>
                            </TabStrip>
                            <ContentControl x:Name="PART_TitleBarContent"
                                            Grid.Column="1"
                                            Content="{Binding ActiveDockable}"
                                            ContentTemplate="{DynamicResource CodeWFToolTitleBarContentTemplate}"
                                            Margin="{DynamicResource CodeWFToolTitleBarContentMargin}" />
                            <!-- Avalonia 12.1 的编译绑定不再把带 IDockable 参数的接口方法直接推断为 ICommand，
                                 这里沿用 Dock 上游的方法命令语义，并仅对该命令使用反射绑定。 -->
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="2"
                                    Command="{ReflectionBinding Owner.Factory.CloseDockable}"
                                    CommandParameter="{Binding ActiveDockable}"
                                    Theme="{TemplateBinding CloseButtonTheme}">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <MultiBinding Converter="{x:Static converters:DockCapabilityConverters.CanCloseMultiConverter}">
                                            <Binding Path="ActiveDockable" />
                                            <Binding Path="ActiveDockable.CanClose" />
                                            <Binding Path="ActiveDockable.DockCapabilityOverrides.CanClose" />
                                            <Binding Path="(core:IDock).DockCapabilityPolicy.CanClose" />
                                        </MultiBinding>
                                        <MultiBinding Converter="{x:Static converters:CanRemoveDockableConverter.Instance}">
                                            <Binding Path="(core:IDock).CanCloseLastDockable" FallbackValue="{x:True}" />
                                            <Binding Path="(core:IDock).OpenedDockablesCount" FallbackValue="0" />
                                        </MultiBinding>
                                    </MultiBinding>
                                </Button.IsVisible>
                                <Viewbox Width="{DynamicResource CodeWFToolTitleBarIconSize}"
                                         Height="{DynamicResource CodeWFToolTitleBarIconSize}">
                                    <Path x:Name="PART_ClosePath" />
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>
                    <Panel x:Name="PART_Panel"
                           Background="{DynamicResource CodeWFToolTitleBarDividerBrush}"
                           Height="{DynamicResource DockToolChromeDividerThickness}"
                           VerticalAlignment="Top"
                           Grid.Row="{Binding GripMode, Converter={x:Static GripModeConverters.GridRowAutoHideConverter}}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^/template/ Border#PART_Border">
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="IsVisible"
                    Value="{Binding GripMode, Converter={x:Static GripModeConverters.IsVisibleVisibleConverter}}" />
        </Style>
        <Style Selector="^:active /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarActiveBackgroundBrush}" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="IsVisible"
                    Value="{Binding GripMode, Converter={x:Static GripModeConverters.IsVisibleAutoHideOrVisibleConverter}}" />
        </Style>

        <Style Selector="^:floating /template/ Border#PART_Border">
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="^/template/ Panel#PART_Panel">
            <Setter Property="IsVisible"
                    Value="{Binding GripMode, Converter={x:Static GripModeConverters.IsVisibleAutoHideOrHiddenConverter}}" />
        </Style>

        <Style Selector="^:pointerover /template/ Panel#PART_Panel">
            <Setter Property="IsVisible"
                    Value="{Binding GripMode, Converter={x:Static GripModeConverters.IsVisibleVisibleOrHiddenConverter}}" />
        </Style>

        <Style Selector="^:floating:pointerover /template/ Panel#PART_Panel">
            <Setter Property="Height" Value="0" />
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^/template/ Grid#PART_Grip">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarBackgroundBrush}" />
            <Setter Property="(DockProperties.IsDragArea)" Value="True" />
        </Style>
        <Style Selector="^:active /template/ Grid#PART_Grip">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarActiveBackgroundBrush}" />
        </Style>
        <Style Selector="^:floating /template/ Grid#PART_Grip">
            <Setter Property="(DockProperties.IsDragArea)"
                    Value="{Binding $parent[HostWindow].ToolChromeControlsWholeWindow, Mode=OneWay, Converter={x:Static BoolConverters.Not}}" />
        </Style>

        <Style Selector="^/template/ TextBlock#PART_Title">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:active /template/ TextBlock#PART_Title">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarActiveForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ TextBlock#PART_Title">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^/template/ TabStrip#PART_TitleTabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="^/template/ TabStrip#PART_TitleTabs TabStripItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="{DynamicResource CodeWFToolTitleBarHeight}" />
            <Setter Property="Padding" Value="6 0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="^/template/ TabStrip#PART_TitleTabs TabStripItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CodeWFToolTitleBarDividerBrush}" />
        </Style>
        <Style Selector="^/template/ TabStrip#PART_TitleTabs TabStripItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource CodeWFToolTitleBarButtonPointerOverBackgroundBrush}" />
        </Style>

        <Style Selector="^/template/ ContentControl#PART_TitleBarContent">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="^/template/ Path#PART_ClosePath">
            <Setter Property="Data" Value="{DynamicResource DockToolIconCloseGeometry}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:active /template/ Path#PART_ClosePath">
            <Setter Property="Fill" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Path#PART_ClosePath">
            <Setter Property="Fill" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^/template/ Button#PART_CloseButton">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:active /template/ Button#PART_CloseButton">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Button#PART_CloseButton">
            <Setter Property="Foreground" Value="{DynamicResource CodeWFToolTitleBarButtonForegroundBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
