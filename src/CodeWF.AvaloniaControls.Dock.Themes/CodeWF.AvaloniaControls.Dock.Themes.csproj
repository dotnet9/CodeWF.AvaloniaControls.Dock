<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Title>CodeWF.AvaloniaControls.Dock.Themes</Title>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
		<Description>CodeWF Dock theme resources for Avalonia Dock controls, based on open-source Dock.Avalonia Fluent and Semi color tokens.</Description>
		<PackageIcon>logo.png</PackageIcon>
		<PackageTags>avalonia ui,dock,theme,fluent</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<RootNamespace>CodeWF.AvaloniaControls.Dock.Themes</RootNamespace>
		<AssemblyName>CodeWF.AvaloniaControls.Dock.Themes</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dock.Avalonia" />
		<PackageReference Include="Dock.Avalonia.Themes.Fluent" />
		<PackageReference Include="Semi.Avalonia" />
		<ProjectReference Include="..\CodeWF.AvaloniaControls.Dock\CodeWF.AvaloniaControls.Dock.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\logo.png" Pack="true" PackagePath="" Link="logo.png" />
		<None Include="..\..\logo.svg" Pack="true" PackagePath="" Link="logo.svg" />
		<None Include="..\..\logo.ico" Pack="true" PackagePath="" Link="logo.ico" />
	</ItemGroup>
</Project>
