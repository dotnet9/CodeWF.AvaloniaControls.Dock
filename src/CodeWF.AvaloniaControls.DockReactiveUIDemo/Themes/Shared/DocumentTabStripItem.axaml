<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="DocumentTabStripItemSelectedActiveBackground">#FFFFFF</SolidColorBrush>
    <StaticResource x:Key="DocumentTabStripItemSelectedInactiveBackground"
                    ResourceKey="DocumentTabStripItemSelectedActiveBackground" />
    <SolidColorBrush x:Key="DocumentTabStripItemBackground">#E7ECF2</SolidColorBrush>
    <SolidColorBrush x:Key="DocumentTabStripItemUnselectedPointeroverBackground">#F3F6FA</SolidColorBrush>
    <SolidColorBrush x:Key="DocumentTabStripItemForeground">#354052</SolidColorBrush>
    <SolidColorBrush x:Key="DocumentTabStripItemSelectedActiveForeground">#111827</SolidColorBrush>
    <StaticResource x:Key="DocumentTabStripItemUnselectedPointeroverForeground"
                    ResourceKey="DocumentTabStripItemSelectedActiveForeground" />

	<x:Double x:Key="DocumentTabStripCloseButtonWidth">18</x:Double>
    <x:Double x:Key="DocumentTabStripCloseButtonContentWidth">16</x:Double>
    <CornerRadius x:Key="DocumentTabStripCloseButtonCornerRadius">4</CornerRadius>
    <Thickness x:Key="DocumentTabStripCloseButtonContentMargin">0 0 -5 0</Thickness>
</ResourceDictionary>
