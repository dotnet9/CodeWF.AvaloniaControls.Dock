<Window
    x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:CodeWF.AvaloniaControls.DockReactiveUIDemo.Views"
    xmlns:vm="clr-namespace:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Width="1240"
    Height="880"
    FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="880"
    d:DesignWidth="1240"
    Icon="/Assets/logo.ico"
    mc:Ignorable="d"
    Title="{Binding Title}">
    <Border Background="#EEF2F6">
        <Grid Margin="14" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <Border Padding="12,8"
                    Background="#2563EB"
                    CornerRadius="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Image Width="24"
                           Height="24"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           Source="/Assets/logo.png" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               IsHitTestVisible="False"
                               Text="{Binding Title}" />
                    <views:TitleBarRightContentView Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="14,12"
                    Background="#FFFFFF"
                    BorderBrush="#D5DBE5"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Text="运维工作台" />
                        <Border Padding="8,3" Background="#EAF2FF" BorderBrush="#BFD4F5" BorderThickness="1" CornerRadius="4">
                            <TextBlock FontSize="12" Foreground="#24558F" Text="生产一线" />
                        </Border>
                        <Border Padding="8,3" Background="#EAF7EF" BorderBrush="#B8DFC7" BorderThickness="1" CornerRadius="4">
                            <TextBlock FontSize="12" Foreground="#1E6B3B" Text="运行正常" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="22">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="#697386" Text="在线节点" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#111827" Text="28" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock FontSize="12" Foreground="#697386" Text="待处理告警" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#B45309" Text="2" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="12" Foreground="#697386" Text="接口延迟" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#111827" Text="14 ms" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="24">
                        <TextBlock Foreground="#4B5563" Text="班次：A 组" />
                        <TextBlock Foreground="#4B5563" Text="窗口：08:00 - 20:00" />
                        <TextBlock Foreground="#4B5563" Text="变更冻结：未启用" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#D5DBE5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <DockControl x:Name="DockControl" Layout="{Binding Layout}" />
            </Border>
        </Grid>
    </Border>
</Window>
