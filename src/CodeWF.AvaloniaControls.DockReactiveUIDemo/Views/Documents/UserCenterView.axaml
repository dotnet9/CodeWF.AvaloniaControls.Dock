<UserControl
    x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.Documents.UserCenterView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels.Documents"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:UserCenterViewModel"
    mc:Ignorable="d">
    <Grid Background="#EEF2F6">
        <ScrollViewer>
            <StackPanel Margin="2" Spacing="10">
                <Border Padding="12"
                        Background="#FFFFFF"
                        BorderBrush="#D5DBE5"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
                            <TextBlock Foreground="#697386" Text="账户身份、权限范围和最近操作。" />
                        </StackPanel>
                        <Border VerticalAlignment="Center"
                                Padding="8,4"
                                Background="#EAF7EF"
                                BorderBrush="#B8DFC7"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock FontSize="12" Foreground="#1E6B3B" FontWeight="SemiBold" Text="在线" />
                        </Border>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="10">
                    <Border Padding="14" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Width="64" Height="64" Background="#EAF2FF" BorderBrush="#BFD4F5" BorderThickness="1" CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="#24558F"
                                           Text="OS" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#111827" Text="开源运维人员" />
                                <TextBlock Foreground="#4B5563" Text="负责工作区质量、样例验证和发布一致性。" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,6,0,0" ItemHeight="30" ItemWidth="124">
                                    <Border Padding="8,4" Background="#F8FAFC" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="4">
                                        <TextBlock FontSize="12" Text="维护者" />
                                    </Border>
                                    <Border Padding="8,4" Background="#EAF7EF" BorderBrush="#B8DFC7" BorderThickness="1" CornerRadius="4">
                                        <TextBlock FontSize="12" Foreground="#1E6B3B" Text="已验证" />
                                    </Border>
                                    <Border Padding="8,4" Background="#FFF7E6" BorderBrush="#F3D39B" BorderThickness="1" CornerRadius="4">
                                        <TextBlock FontSize="12" Foreground="#8A5A00" Text="双重验证" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="账户状态" />
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                <TextBlock Foreground="#4B5563" Text="会话" />
                                <TextBlock Grid.Column="1" Foreground="#1E6B3B" FontWeight="SemiBold" Text="活动" />
                            </Grid>
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                <TextBlock Foreground="#4B5563" Text="权限组" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="运维" />
                            </Grid>
                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                                <TextBlock Foreground="#4B5563" Text="上次验证" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="10:12" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="7">
                            <TextBlock FontWeight="SemiBold" Foreground="#111827" Text="权限范围" />
                            <TextBlock Foreground="#4B5563" Text="布局恢复、文档定位、运行面板查看" TextWrapping="Wrap" />
                            <TextBlock Foreground="#4B5563" Text="发布审批：只读" />
                            <TextBlock Foreground="#4B5563" Text="系统设置：可查看、可切换本地偏好" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="7">
                            <TextBlock FontWeight="SemiBold" Foreground="#111827" Text="最近操作" />
                            <TextBlock Foreground="#4B5563" Text="10:19 重新打开系统设置" />
                            <TextBlock Foreground="#4B5563" Text="10:16 查看诊断巡检结果" />
                            <TextBlock Foreground="#4B5563" Text="10:14 保存布局快照" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="12" Foreground="#697386" Text="本周登录" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="18" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock FontSize="12" Foreground="#697386" Text="文档恢复" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="7" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock FontSize="12" Foreground="#697386" Text="待确认通知" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#8A5A00" Text="2" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
