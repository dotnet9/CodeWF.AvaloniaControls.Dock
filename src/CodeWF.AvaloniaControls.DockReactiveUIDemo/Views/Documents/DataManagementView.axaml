<UserControl
    x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.Documents.DataManagementView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels.Documents"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:DataManagementViewModel"
    mc:Ignorable="d">
    <Grid Background="#EEF2F6" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Padding="12"
                Background="#FFFFFF"
                BorderBrush="#D5DBE5"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
                    <TextBlock Foreground="#697386" Text="发布计划、资源池和审批流统一跟踪。" />
                </StackPanel>
                <Border VerticalAlignment="Center"
                        Padding="8,4"
                        Background="#FFF7E6"
                        BorderBrush="#F3D39B"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Foreground="#8A5A00" FontSize="12" FontWeight="SemiBold" Text="审批中" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="12" Foreground="#697386" Text="待审核计划" />
                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="12" />
                    <TextBlock Foreground="#4B5563" Text="参数、版本和批量调度" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="12" Foreground="#697386" Text="运行资源池" />
                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#111827" Text="28" />
                    <TextBlock Foreground="#4B5563" Text="26 台可接管" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="5">
                    <TextBlock FontSize="12" Foreground="#697386" Text="变更任务" />
                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#B45309" Text="5" />
                    <TextBlock Foreground="#4B5563" Text="今日仍需跟进" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="10">
            <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#111827" Text="发布编排" />
                        <TextBlock Foreground="#697386" Text="任务状态和回滚步骤按值守顺序排列。" />
                    </StackPanel>

                    <TabControl Grid.Row="1">
                        <TabItem Header="任务队列">
                            <StackPanel Margin="4" Spacing="8">
                                <Border Padding="12" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="参数模板同步" />
                                            <TextBlock Foreground="#697386" Text="3 套工艺参数等待东区窗口确认。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border VerticalAlignment="Top" Padding="8,3" Background="#EAF2FF" BorderBrush="#BFD4F5" BorderThickness="1" CornerRadius="4">
                                            <TextBlock Foreground="#24558F" FontSize="12" FontWeight="SemiBold" Text="待确认" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Padding="12" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="数据归档清理" />
                                            <TextBlock Foreground="#697386" Text="回收 14 天前缓存，保留告警快照。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border VerticalAlignment="Top" Padding="8,3" Background="#FFF7E6" BorderBrush="#F3D39B" BorderThickness="1" CornerRadius="4">
                                            <TextBlock Foreground="#8A5A00" FontSize="12" FontWeight="SemiBold" Text="排队中" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Padding="12" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="灰度版本发布" />
                                            <TextBlock Foreground="#697386" Text="2 个备用节点热切后推广到主线。" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border VerticalAlignment="Top" Padding="8,3" Background="#EAF7EF" BorderBrush="#B8DFC7" BorderThickness="1" CornerRadius="4">
                                            <TextBlock Foreground="#1E6B3B" FontSize="12" FontWeight="SemiBold" Text="已就绪" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="资源池">
                            <Grid Margin="4" ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border Padding="12" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="在线节点" />
                                        <TextBlock Foreground="#697386" Text="主线 A-01 到 A-12 心跳正常。" TextWrapping="Wrap" />
                                        <TextBlock Foreground="#1E6B3B" FontWeight="SemiBold" Text="可用率 100%" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="12" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold" Text="备用节点" />
                                        <TextBlock Foreground="#697386" Text="B-03 预热，B-07 维护中。" TextWrapping="Wrap" />
                                        <TextBlock Foreground="#8A5A00" FontWeight="SemiBold" Text="需关注 2 台" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="回滚预案">
                            <Border Margin="4" Padding="12" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                                <StackPanel Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="执行顺序" />
                                    <TextBlock Foreground="#697386" Text="1. 冻结新增任务  2. 切回上一版参数快照  3. 恢复缓存目录  4. 开放调度" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="10">
                <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="今日值守要点" />
                        <TextBlock Foreground="#4B5563" Text="19:30 前完成东区参数模板复核。" TextWrapping="Wrap" />
                        <TextBlock Foreground="#4B5563" Text="灰度节点观察窗口不少于 30 分钟。" TextWrapping="Wrap" />
                        <TextBlock Foreground="#4B5563" Text="夜间清理不得影响日志保留周期。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="审批流" />
                        <TextBlock Foreground="#1E6B3B" Text="运维负责人：已审批" />
                        <TextBlock Foreground="#8A5A00" Text="工艺负责人：待审批" />
                        <TextBlock Foreground="#4B5563" Text="质量追溯：无需审批" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
