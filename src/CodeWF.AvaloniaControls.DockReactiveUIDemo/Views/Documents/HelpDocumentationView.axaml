<UserControl
    x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.Documents.HelpDocumentationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels.Documents"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:HelpDocumentationViewModel"
    mc:Ignorable="d">
    <Grid Background="#EEF2F6" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Border Padding="12"
                Background="#FFFFFF"
                BorderBrush="#D5DBE5"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Spacing="3">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
                <TextBlock Foreground="#697386" Text="内嵌进程和宿主窗口状态。" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="10,8"
                Background="#F8FAFC"
                BorderBrush="#D5DBE5"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Foreground="#4B5563" Text="{Binding Tip}" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="1.25*,0.75*" ColumnSpacing="10">
            <Border Padding="8"
                    Background="#FFFFFF"
                    BorderBrush="#D5DBE5"
                    BorderThickness="1"
                    CornerRadius="8">
                <ContentControl Name="HostProcessWin" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="10">
                <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="宿主状态" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Foreground="#4B5563" Text="进程句柄" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="已请求" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Foreground="#4B5563" Text="窗口嵌入" />
                            <TextBlock Grid.Column="1" Foreground="#1E6B3B" FontWeight="SemiBold" Text="运行中" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="检查项" />
                        <TextBlock Foreground="#4B5563" Text="保持 Dock 页签切换响应。" TextWrapping="Wrap" />
                        <TextBlock Foreground="#4B5563" Text="嵌入窗口关闭时释放外部进程。" TextWrapping="Wrap" />
                        <TextBlock Foreground="#4B5563" Text="标题栏菜单仍可定位文档。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
