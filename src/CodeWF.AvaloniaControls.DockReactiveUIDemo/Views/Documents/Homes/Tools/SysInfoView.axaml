<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels.Documents.Homes.Tools"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:SysInfoViewModel"
             x:CompileBindings="True"
             x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.Documents.Homes.Tools.SysInfoView">
    <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="10">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Foreground="#697386" Text="运行时" />
                <TextBlock Grid.Column="1" Text=".NET 11 预览版" />
                <TextBlock Grid.Row="1" Foreground="#697386" Text="UI 框架" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Avalonia 12.0.3" />
                <TextBlock Grid.Row="2" Foreground="#697386" Text="主题链路" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Ursa + Semi" />
                <TextBlock Grid.Row="3" Foreground="#697386" Text="打包" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="win-x64 / linux-x64" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>


