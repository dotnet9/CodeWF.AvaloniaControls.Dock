<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels.Documents.Homes.Tools"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:AlertLatestViewModel"
             x:CompileBindings="True"
             x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.Documents.Homes.Tools.AlertLatestView">
    <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="8">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
            <Border Padding="9" Background="#FCEBEC" BorderBrush="#F0B8BE" BorderThickness="1" CornerRadius="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Width="8" Height="8" Background="#B4232C" CornerRadius="4" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="冷却回路压力低于阈值。" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Foreground="#B4232C" FontWeight="SemiBold" Text="P1" />
                </Grid>
            </Border>
            <Border Padding="9" Background="#FFF7E6" BorderBrush="#F3D39B" BorderThickness="1" CornerRadius="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Width="8" Height="8" Background="#D9822B" CornerRadius="4" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="备份流程延迟 3 分钟。" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Foreground="#8A5A00" FontWeight="SemiBold" Text="P2" />
                </Grid>
            </Border>
            <Border Padding="9" Background="#EAF2FF" BorderBrush="#BFD4F5" BorderThickness="1" CornerRadius="6">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Width="8" Height="8" Background="#2F6CAD" CornerRadius="4" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="维护窗口将于 23:30 开始。" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Foreground="#24558F" FontWeight="SemiBold" Text="信息" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>

