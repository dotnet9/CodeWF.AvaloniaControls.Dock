<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels.Documents.Homes.Tools"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:LogViewModel"
             x:CompileBindings="True"
             x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.Documents.Homes.Tools.LogView">
    <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="9">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock FontWeight="SemiBold" Foreground="#24558F" Text="10:14" />
                <TextBlock Grid.Column="1" Foreground="#4B5563" Text="工作区快照已保存。" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock FontWeight="SemiBold" Foreground="#1E6B3B" Text="10:16" />
                <TextBlock Grid.Column="1" Foreground="#4B5563" Text="后台诊断完成。" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock FontWeight="SemiBold" Foreground="#8A5A00" Text="10:19" />
                <TextBlock Grid.Column="1" Foreground="#4B5563" Text="重新打开设置文档。" TextWrapping="Wrap" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

