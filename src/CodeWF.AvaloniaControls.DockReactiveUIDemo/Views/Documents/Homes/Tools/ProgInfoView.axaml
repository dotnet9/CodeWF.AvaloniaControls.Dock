<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels.Documents.Homes.Tools"
             xmlns:models="using:CodeWF.AvaloniaControls.DockReactiveUIDemo.Models.Documents.Homes.Tools"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:ProgInfoViewModel"
             x:CompileBindings="True"
             x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.Documents.Homes.Tools.ProgInfoView">
    <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="10">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
            <TextBlock Foreground="#697386"
                       Text="嵌套进程、节点和流水线层级。" />
            <Border Padding="8" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                <TreeView ItemsSource="{Binding MultipleLevelItems}">
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="models:FirstItem" ItemsSource="{Binding SecondItems}">
                            <TextBlock Text="{Binding Name}" />
                        </TreeDataTemplate>
                        <TreeDataTemplate DataType="models:SecondItem" ItemsSource="{Binding ThirdItemItems}">
                            <TextBlock Text="{Binding Name}" />
                        </TreeDataTemplate>
                        <TreeDataTemplate DataType="models:ThirdItem">
                            <TextBlock Text="{Binding Name}" />
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
