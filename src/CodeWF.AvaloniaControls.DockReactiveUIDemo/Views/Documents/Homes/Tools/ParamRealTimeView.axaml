<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels.Documents.Homes.Tools"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:ParamRealTimeViewModel"
             x:CompileBindings="True"
             x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.Documents.Homes.Tools.ParamRealTimeView">
    <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="10">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Foreground="#4B5563" Text="CPU 负载" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="42%" />
                </Grid>
                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="42" />
            </StackPanel>
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Foreground="#4B5563" Text="内存使用率" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="68%" />
                </Grid>
                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="68" />
            </StackPanel>
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Foreground="#4B5563" Text="队列深度" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="23%" />
                </Grid>
                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="23" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

