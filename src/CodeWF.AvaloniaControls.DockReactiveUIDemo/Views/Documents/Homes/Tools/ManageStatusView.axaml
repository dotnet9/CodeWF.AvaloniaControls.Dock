<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels.Documents.Homes.Tools"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:ManageStatusViewModel"
             x:CompileBindings="True"
             x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.Documents.Homes.Tools.ManageStatusView">
    <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="10">
            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Foreground="#4B5563" Text="外壳路由服务" />
                <Border Grid.Column="1" Padding="8,3" Background="#EAF7EF" BorderBrush="#B8DFC7" BorderThickness="1" CornerRadius="4">
                    <TextBlock Foreground="#1E6B3B" FontSize="12" Text="健康" />
                </Border>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Foreground="#4B5563" Text="遥测聚合服务" />
                <Border Grid.Column="1" Padding="8,3" Background="#FFF7E6" BorderBrush="#F3D39B" BorderThickness="1" CornerRadius="4">
                    <TextBlock Foreground="#8A5A00" FontSize="12" Text="需关注" />
                </Border>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Foreground="#4B5563" Text="外部同步网关" />
                <Border Grid.Column="1" Padding="8,3" Background="#FCEBEC" BorderBrush="#F0B8BE" BorderThickness="1" CornerRadius="4">
                    <TextBlock Foreground="#B4232C" FontSize="12" Text="待检查" />
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

