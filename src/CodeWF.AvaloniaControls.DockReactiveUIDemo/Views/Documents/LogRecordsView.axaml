<UserControl
    x:Class="CodeWF.AvaloniaControls.DockReactiveUIDemo.Views.Documents.LogRecordsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:CodeWF.AvaloniaControls.DockReactiveUIDemo.ViewModels.Documents"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:LogRecordsViewModel"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Border Padding="12"
                Background="#FFFFFF"
                BorderBrush="#D5DBE5"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Spacing="3">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#111827" Text="{Binding Title}" />
                <TextBlock Foreground="#697386" Text="活动、告警和文档操作按时间顺序归档。" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="10">
            <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#111827" Text="操作时间线" />
                        <TextBlock Foreground="#697386" Text="最近一次值守操作和自动记录。" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="8">
                            <Border Padding="12" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="64" Padding="8,4" Background="#EAF2FF" BorderBrush="#BFD4F5" BorderThickness="1" CornerRadius="4">
                                        <TextBlock HorizontalAlignment="Center" Foreground="#24558F" FontSize="12" FontWeight="SemiBold" Text="10:14" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="布局快照已保存" />
                                        <TextBlock Foreground="#697386" Text="分析页签拖出主工作区后，系统记录停靠结构并生成本地快照。" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Padding="12" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="64" Padding="8,4" Background="#EAF7EF" BorderBrush="#B8DFC7" BorderThickness="1" CornerRadius="4">
                                        <TextBlock HorizontalAlignment="Center" Foreground="#1E6B3B" FontSize="12" FontWeight="SemiBold" Text="10:16" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="诊断巡检完成" />
                                        <TextBlock Foreground="#697386" Text="后台健康检查未发现阻塞性问题，文档恢复速度稳定。" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Padding="12" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="64" Padding="8,4" Background="#FFF7E6" BorderBrush="#F3D39B" BorderThickness="1" CornerRadius="4">
                                        <TextBlock HorizontalAlignment="Center" Foreground="#8A5A00" FontSize="12" FontWeight="SemiBold" Text="10:19" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="重新打开设置文档" />
                                        <TextBlock Foreground="#697386" Text="值守人员通过标题栏菜单定位到系统设置页。" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Padding="12" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="64" Padding="8,4" Background="#F4ECFF" BorderBrush="#D8C7F5" BorderThickness="1" CornerRadius="4">
                                        <TextBlock HorizontalAlignment="Center" Foreground="#6D3CB3" FontSize="12" FontWeight="SemiBold" Text="10:23" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="告警路由同步" />
                                        <TextBlock Foreground="#697386" Text="活动流规则同步到外部通知通道。" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="10">
                <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="事件分类" />
                        <TextBlock Foreground="#4B5563" Text="布局类：8" />
                        <TextBlock Foreground="#4B5563" Text="运维类：14" />
                        <TextBlock Foreground="#4B5563" Text="告警类：3" />
                    </StackPanel>
                </Border>
                <Border Padding="12" Background="#FFFFFF" BorderBrush="#D5DBE5" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#111827" Text="需复核事项" />
                        <TextBlock Foreground="#4B5563" Text="检查设置页缓存是否正确回收。" TextWrapping="Wrap" />
                        <TextBlock Foreground="#4B5563" Text="确认日志轮转不打断夜间导出。" TextWrapping="Wrap" />
                        <TextBlock Foreground="#4B5563" Text="跟踪通知通道回执。" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
