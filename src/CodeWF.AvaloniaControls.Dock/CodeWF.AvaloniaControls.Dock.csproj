<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>CodeWF.AvaloniaControls.Dock</Title>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <Description>Avalonia Dock extension controls built on the open-source Dock.Avalonia package.</Description>
    <PackageIcon>logo.png</PackageIcon>
    <PackageTags>avalonia ui dock controls custom</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>CodeWF.AvaloniaControls.Dock</RootNamespace>
    <AssemblyName>CodeWF.AvaloniaControls.Dock</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="Dock.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\logo.png" Pack="true" PackagePath="" Link="logo.png" />
    <None Include="..\..\logo.svg" Pack="true" PackagePath="" Link="logo.svg" />
    <None Include="..\..\logo.ico" Pack="true" PackagePath="" Link="logo.ico" />
  </ItemGroup>
</Project>