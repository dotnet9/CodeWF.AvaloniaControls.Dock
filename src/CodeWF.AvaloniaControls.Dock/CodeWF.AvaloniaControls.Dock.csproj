<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Title>CodeWF.AvaloniaControls.Dock</Title>
		<TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>
		<IsPackable>true</IsPackable>
		<Description>封装一些基于 Avalonia 的 Dock 扩展控件，直接依赖开源 Dock.Avalonia。Encapsulate Avalonia Dock extension controls based on the open-source Dock.Avalonia package.</Description>
		<PackageIcon>logo.png</PackageIcon>
		<PackageTags>avalonia ui,dock,controls,custom</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<RootNamespace>CodeWF.AvaloniaControls.Dock</RootNamespace>
		<AssemblyName>CodeWF.AvaloniaControls.Dock</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dock.Avalonia" />
	</ItemGroup>

	<ItemGroup>
		<None Include="logo.png" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>
