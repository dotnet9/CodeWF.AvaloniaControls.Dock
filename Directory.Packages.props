<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AvaloniaVersion>12.0.4</AvaloniaVersion>
    <DockVersion>12.0.0.2</DockVersion>
    <ReactiveUIAvaloniaVersion>12.0.3</ReactiveUIAvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageVersion Include="CodeWF.EventBus" Version="3.4.5.8" />
    <PackageVersion Include="CodeWF.Log.Core" Version="12.0.4.2" />
    <PackageVersion Include="Dock.Avalonia" Version="$(DockVersion)" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
    <PackageVersion Include="Dock.Model.ReactiveUI" Version="$(DockVersion)" />
    <PackageVersion Include="Prism.DryIoc.Avalonia" Version="8.1.97.11073" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="$(ReactiveUIAvaloniaVersion)" />
    <PackageVersion Include="Semi.Avalonia" Version="12.0.3" />
    <PackageVersion Include="StaticViewLocator" Version="0.4.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.9" />
    <PackageVersion Include="System.Security.Permissions" Version="10.0.9" />
    <PackageVersion Include="System.Windows.Extensions" Version="10.0.9" />
    <PackageVersion Include="VC-LTL" Version="5.3.1" />
    <PackageVersion Include="Xaml.Behaviors" Version="12.0.0.1" />
    <PackageVersion Include="YY-Thunks" Version="1.2.2-Beta.2" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
  </ItemGroup>
</Project>
