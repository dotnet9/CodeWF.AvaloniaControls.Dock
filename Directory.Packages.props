<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.0.2</AvaloniaVersion>
    <DockVersion>12.0.0.2</DockVersion>
    <ReactiveUIAvaloniaVersion>12.0.1</ReactiveUIAvaloniaVersion>
    <SemiAvaloniaVersion>12.0.1</SemiAvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.0.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="CodeWF.AvaloniaControls.Themes" Version="12.0.3.2" />
    <PackageVersion Include="CodeWF.EventBus" Version="3.4.5.1" />
    <PackageVersion Include="CodeWF.Log.Core" Version="12.0.2.1" />
    <PackageVersion Include="Dock.Model.ReactiveUI" Version="$(DockVersion)" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="2.0.0" />
    <PackageVersion Include="Prism.DryIoc.Avalonia" Version="8.1.97.11073" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="$(ReactiveUIAvaloniaVersion)" />
    <PackageVersion Include="Semi.Avalonia" Version="$(SemiAvaloniaVersion)" />
    <PackageVersion Include="Semi.Avalonia.Dock" Version="12.0.0.2" />
    <PackageVersion Include="StaticViewLocator" Version="0.4.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.6" />
    <PackageVersion Include="VC-LTL" Version="5.3.1" />
    <PackageVersion Include="Xaml.Behaviors" Version="12.0.0.1" />
    <PackageVersion Include="YY-Thunks" Version="1.2.2-Beta.2" />
  </ItemGroup>
</Project>